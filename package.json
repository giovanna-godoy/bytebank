{
  "name": "bytebank",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "start:shell": "ng serve --port 4200",
    "start:api": "json-server --watch api/db.json --port 3000",
    "start:api:local": "json-server --watch api/db.json --port 3000",
    "start:shell:local": "ng serve --port 4200 --configuration development",
    "start:mfe": "ng serve investments-mfe --port 4201",
    "start:mfe:local": "ng serve investments-mfe --port 4201 --configuration development",
    "start:mfe:prod": "ng serve investments-mfe --port 4201 --configuration production",
    "start:all": "concurrently \"npm run start:api\" \"npm run start:shell\" \"npm run start:mfe\"",
    "start:all:local": "concurrently \"npm run start:api:local\" \"npm run start:shell:local\" \"npm run start:mfe:local\"",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:mfe": "ng build investments-mfe",
    "build:all": "npm run build && npm run build:mfe",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "e2e:ci": "start-server-and-test start:all:local http://localhost:4200 'cypress run'",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "analyze": "ng build --source-map && npx source-map-explorer dist/bytebank/**/*.js",
    "analyze:webpack": "ng build --stats-json && npx webpack-bundle-analyzer dist/bytebank/stats.json",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "serve:ssr:bytebank": "node dist/bytebank/server/server.mjs",
    "storybook": "ng run bytebank:storybook",
    "build-storybook": "ng run bytebank:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.15",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.15",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.11",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@ngrx/store-devtools": "^19.2.1",
    "@storybook/addon-docs": "^8.6.14",
    "chart.js": "^4.5.0",
    "express": "^4.18.2",
    "moment": "^2.30.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "webpack": "^5.100.2",
    "webpack-dev-server": "^5.2.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-architects/module-federation": "^20.0.0",
    "@angular-devkit/build-angular": "^19.2.11",
    "@angular/cli": "^19.2.11",
    "@angular/compiler-cli": "^19.2.0",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/addon-onboarding": "^8.6.12",
    "@storybook/angular": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "concurrently": "^9.2.0",
    "cypress": "^13.6.0",
    "husky": "^8.0.3",
    "jasmine-core": "~5.6.0",
    "json-server": "^0.17.4",
    "karma": "~6.4.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "source-map-explorer": "^2.5.3",
    "standard-version": "^9.5.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "storybook": "^8.6.12",
    "typescript": "~5.7.2"
  }
}
